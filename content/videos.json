    "related": { "unitId": "unit-1", "situationId": "situation-1", "labelKo": "혈압·체온 측정" },
    "cues": [
      { "id": "bp-1", "start": 0, "end": 4, "speakerKo": "실습생", "textKo": "안녕하세요, 김영희 환자분. 잘 주무셨어요?", "textEn": "Good morning, Ms. Kim Younghee. Did you sleep well?", "terms": [{ "hangul": "환자분", "glossEn": "patient (honorific)" }, { "hangul": "주무셨어요", "glossEn": "did you sleep (honorific)" }] },
      { "id": "bp-2", "start": 4, "end": 8, "speakerKo": "환자", "textKo": "네, 그런데 조금 어지러워요.", "textEn": "Yes, but I feel a little dizzy.", "terms": [{ "hangul": "어지러워요", "glossEn": "(I) feel dizzy" }] },
      { "id": "bp-3", "start": 8, "end": 12, "speakerKo": "실습생", "textKo": "그러면 혈압 좀 재겠습니다.", "textEn": "Then I'll take your blood pressure.", "terms": [{ "hangul": "혈압", "glossEn": "blood pressure" }, { "hangul": "재겠습니다", "glossEn": "I will measure" }] },
      { "id": "bp-4", "start": 12, "end": 16, "speakerKo": "실습생", "textKo": "팔을 조금만 올려 주세요.", "textEn": "Please raise your arm a little.", "terms": [{ "hangul": "올려 주세요", "glossEn": "please raise" }] },
      { "id": "bp-5", "start": 16, "end": 20, "speakerKo": "실습생", "textKo": "조금 조일 수 있어요. 괜찮으세요?", "textEn": "It may feel a little tight. Are you okay?", "terms": [{ "hangul": "조일 수 있어요", "glossEn": "it may squeeze / feel tight" }] },
      { "id": "bp-6", "start": 20, "end": 24, "speakerKo": "환자", "textKo": "네, 괜찮아요.", "textEn": "Yes, I'm okay.", "terms": [{ "hangul": "괜찮아요", "glossEn": "it's okay" }] },
      { "id": "bp-7", "start": 24, "end": 28, "speakerKo": "실습생", "textKo": "체온도 같이 확인하겠습니다.", "textEn": "I'll also check your temperature.", "terms": [{ "hangul": "체온", "glossEn": "body temperature" }, { "hangul": "확인하겠습니다", "glossEn": "I will check" }] },
      { "id": "bp-8", "start": 28, "end": 32, "speakerKo": "실습생", "textKo": "어지러운 것은 간호사 선생님께 말씀드릴게요.", "textEn": "I'll tell the nurse about your dizziness.", "terms": [{ "hangul": "말씀드릴게요", "glossEn": "I will tell (humble)" }] },
      { "id": "bp-9", "start": 32, "end": 36, "speakerKo": "실습생", "textKo": "불편하시면 언제든지 벨을 눌러 주세요.", "textEn": "If you feel uncomfortable, press the call bell anytime.", "terms": [{ "hangul": "불편하시면", "glossEn": "if you are uncomfortable" }, { "hangul": "벨", "glossEn": "call bell" }] }
    ]
