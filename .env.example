# Gemini API 키 (LLM 대화 + 학습 음성 TTS 기능 공용). https://aistudio.google.com/app/apikey 에서 발급.
# 무료 테스트 티어가 있는 gemini-1.5-flash 계열 모델을 기본으로 사용합니다.
GEMINI_API_KEY=
# (선택) 영상 에디터 "AI 자동 자막"에 쓸 모델. 비우면 gemini-1.5-flash (docs/VIDEO_EDITOR_DESIGN.md §4)
GEMINI_VIDEO_MODEL=
# (선택) 학습 음성(TTS)에 쓸 모델. 비우면 gemini-2.5-flash-preview-tts.
# 음색은 모델이 아니라 관리자 화면(/admin/voice-settings)에서 고릅니다(content/ttsSettings.json).
GEMINI_TTS_MODEL=

# ---- 로그인·보안 (docs/SECURITY.md) ----
# 세션 쿠키 서명 키(32자 이상 임의 문자열). 운영(npm run start)에서는 반드시 필요합니다.
#   만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# 계정 비밀번호. 운영에서 비워 두면 그 계정은 로그인할 수 없습니다(개발 중에는 admin / 1234).
ADMIN_PASSWORD=
STUDENT_PASSWORD=
# 로그인 화면의 "데모 계정으로 바로 시작" 버튼. 운영에서는 기본으로 꺼져 있습니다.
ALLOW_DEMO_LOGIN=false
# HTTPS 없이(http://) 운영 서버를 열 때만 true. 그 밖에는 비워 두세요.
SESSION_COOKIE_INSECURE=
# nginx·로드밸런서 같은 리버스 프록시 뒤에서 돌릴 때만 true (X-Forwarded-For로 접속 IP 확인).
TRUST_PROXY=
